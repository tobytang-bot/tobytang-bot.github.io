---
import { getCollection } from "astro:content";
import ListLayout from "../../layouts/ListLayout.astro";
import { getArticles, isoDate, lastModified } from "../../lib/content";

const [projects, articles] = await Promise.all([getCollection("projects"), getArticles()]);

const rows = projects
  .map((p) => {
    const entries = articles.filter((a) => a.data.project?.id === p.id);
    return { project: p, count: entries.length, latest: entries[0] && lastModified(entries[0]) };
  })
  .sort(
    (a, b) =>
      (b.latest?.getTime() ?? 0) - (a.latest?.getTime() ?? 0) ||
      a.project.data.title.localeCompare(b.project.data.title),
  );
---

<ListLayout title="项目" description="正在建设的项目，以及相关技术笔记。">
  {
    rows.length === 0 ? (
      <p class="empty">还没有项目。在 src/content/projects/ 下新增一个 YAML 文件即可创建。</p>
    ) : (
      <ul class="projects">
        {rows.map(({ project, count, latest }) => (
          <li>
            <a href={`/projects/${project.id}/`}>{project.data.title}</a>
            <p>{project.data.description}</p>
            <div class="row">
              <span>{count} 篇</span>
              {latest && (
                <span>
                  最近更新 <time datetime={isoDate(latest)}>{isoDate(latest)}</time>
                </span>
              )}
            </div>
          </li>
        ))}
      </ul>
    )
  }
</ListLayout>

<style>
  .projects {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  li {
    padding: 1.5rem;
    margin: 1rem 0;
    background: var(--surface-2);
    border-top: 2px solid var(--accent);
    border-bottom: 1px solid var(--border);
  }

  a {
    font-size: var(--text-lg);
    font-weight: 600;
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
  }

  p {
    margin: 0.3rem 0 0.5rem;
    color: var(--ink-2);
  }

  .row {
    display: flex;
    gap: 1.25rem;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }

  .empty {
    color: var(--ink-3);
  }
</style>
