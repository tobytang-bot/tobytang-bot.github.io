---
import type { GetStaticPaths } from "astro";
import { getWorklogs, worklogSlug, type Worklog } from "../../lib/content";
import { SITE } from "../../site";

export const getStaticPaths = (async () => {
  const entries = await getWorklogs();
  return entries.map((entry) => ({
    params: { slug: worklogSlug(entry) },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props as { entry: Worklog };
// filePath keeps the real extension (.md or .mdx); the id has none.
const file = entry.filePath ?? `src/content/worklog/${entry.id}.md`;
return Astro.redirect(`${SITE.repository}/blob/main/${file}`);
---
