---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import { getArticles } from "../lib/content";

const recent = (await getArticles()).slice(0, 10);
---

<BaseLayout
  title="Toby Worklog"
  description="Magento、Cloud、PHP、DevOps 与 AI 工作流的工作日志、知识库和问题解决记录。"
>
  <div class="home">
    <h1>Toby Worklog</h1>
    <p class="lede">Magento、Cloud、PHP、DevOps 与 AI 工作流的工作日志、知识库和问题解决记录。</p>

    <section aria-labelledby="recent-title">
      <h2 id="recent-title">最近更新</h2>
      <ArticleList entries={recent} />
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: var(--measure);
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: var(--text-3xl);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0 0 3rem;
    color: var(--ink-2);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-3);
  }
</style>
