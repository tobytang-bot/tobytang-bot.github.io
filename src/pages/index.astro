---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import HeroIntro from "../components/home/HeroIntro.astro";
import { graphTopics } from "../lib/motion/graph-data";
import { articleUrl, getArticles, isoDate, lastModified } from "../lib/content";
import { STATUS_LABEL } from "../lib/status";
import { getResources } from "../lib/resources";
import { getTopics, inTopic, topicUrl } from "../lib/topics";
import { SITE } from "../site";

const [articles, topics, projects, resources] = await Promise.all([
  getArticles(),
  getTopics(),
  getCollection("projects"),
  getResources(),
]);
const knowledge = articles.filter((a) => a.collection === "knowledge");
const investigating = articles.filter((a) => a.data.status === "investigating");

const title = (id: string) => topics.get(id)?.data.title ?? id;
const countIn = (id: string) => inTopic(id, articles, topics).length;
// 分类页按文章 + 资源生成，链接是否可用需与路由使用同一口径。
const hasTopicPage = (id: string) => inTopic(id, [...articles, ...resources], topics).length > 0;

const stats = [
  { label: "全部文章", value: String(articles.length), url: "/archive/" },
  ...SITE.featuredTopics.map((id) => {
    const n = countIn(id);
    return { label: title(id), value: String(n), url: hasTopicPage(id) ? topicUrl(id) : undefined };
  }),
  { label: "资源", value: String(resources.length), url: "/resources/" },
  {
    label: "最近更新",
    value: articles[0] ? isoDate(lastModified(articles[0])) : "—",
    url: articles[0] ? articleUrl(articles[0]) : undefined,
  },
];

// Knowledge by top-level folder (the article's primary topic).
const knowledgeTopics = [...new Set(knowledge.map((k) => k.id.split("/")[0]))]
  .map((id) => ({ id, count: knowledge.filter((k) => k.id.startsWith(`${id}/`)).length }))
  .sort((a, b) => b.count - a.count || title(a.id).localeCompare(title(b.id), "zh-CN"));

const projectRows = projects
  .map((p) => ({ project: p, count: articles.filter((a) => a.data.project?.id === p.id).length }))
  .sort((a, b) => b.count - a.count);

const website = {
  "@type": "WebSite",
  name: SITE.title,
  description: SITE.description,
  url: new URL("/", Astro.site).href,
  inLanguage: SITE.lang,
  author: { "@type": "Person", name: SITE.author.name, url: SITE.author.url },
};
---

<BaseLayout title={SITE.title} structuredData={[website]}>
  <div class="dashboard">
    <HeroIntro focus={SITE.focus.map((id) => ({ label: title(id), href: hasTopicPage(id) ? topicUrl(id) : undefined }))} nodes={graphTopics(topics, [...articles, ...resources])} />

    <dl class="stats">
      {
        stats.map((s) => (
          <div>
            <dt>{s.label}</dt>
            <dd>{s.url ? <a href={s.url}>{s.value}</a> : s.value}</dd>
          </div>
        ))
      }
    </dl>

    {
      investigating.length > 0 && (
        <section class="open" aria-labelledby="open-title" data-status="investigating">
          <h2 id="open-title">{STATUS_LABEL.investigating}（{investigating.length}）</h2>
          <ArticleList entries={investigating} />
        </section>
      )
    }

    <div class="columns">
      <section class="recent" aria-labelledby="recent-title" data-reveal>
        <div class="section-head">
          <h2 id="recent-title">最近更新</h2>
          <a href="/archive/">全部归档</a>
        </div>
        <ArticleList entries={articles.slice(0, 6)} />
      </section>

      <aside class="side">
        <section aria-labelledby="knowledge-title" data-reveal>
          <div class="section-head">
            <h2 id="knowledge-title">Knowledge</h2>
            <a href="/knowledge/">全部</a>
          </div>
          <ul class="index">
            {
              knowledgeTopics.map(({ id, count }) => (
                <li>
                  <a href={topicUrl(id)}>{title(id)}</a>
                  <span>{count}</span>
                </li>
              ))
            }
          </ul>
        </section>

        <section aria-labelledby="projects-title" data-reveal>
          <div class="section-head">
            <h2 id="projects-title">Projects</h2>
            <a href="/projects/">全部</a>
          </div>
          <ul class="index">
            {
              projectRows.map(({ project, count }) => (
                <li>
                  <a href={`/projects/${project.id}/`}>{project.data.title}</a>
                  <span>{count}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .dashboard {
    max-width: 62rem;
  }

  /* Stats: one hairline-divided row, not a row of cards. */
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    margin: 0 0 3rem;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
  }

  .stats div {
    padding: 0.9rem 1rem 1rem;
  }

  .stats div + div {
    border-left: 1px solid var(--border);
  }

  .stats dt {
    margin-bottom: 0.2rem;
    color: var(--ink-3);
    font-size: var(--text-sm);
  }

  .stats dd {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }

  .stats dd a {
    text-decoration: none;
  }

  .stats dd a:hover {
    color: var(--accent);
  }

  .open {
    margin: 0 0 3rem;
    padding-left: 1rem;
    border-left: 3px solid var(--status-color);
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(14rem, 1fr);
    gap: 3rem;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  h2 {
    margin: 0;
    font-size: var(--text-base);
    font-weight: 600;
  }

  .open h2 {
    margin-bottom: 0.75rem;
  }

  .section-head a {
    color: var(--ink-3);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .section-head a:hover {
    color: var(--accent);
  }

  .index {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--border);
  }

  .index li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--border);
  }

  .index a {
    font-weight: 500;
    text-decoration: none;
  }

  .index a:hover {
    color: var(--accent);
  }

  .index span {
    color: var(--ink-3);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1100px) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 560px) {
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .stats div + div {
      border-left: 0;
    }
    .stats div:nth-child(even) {
      border-left: 1px solid var(--border);
    }
    .stats div:nth-child(n + 3) {
      border-top: 1px solid var(--border);
    }
  }
</style>
