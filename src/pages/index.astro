---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import EditorialHero from "../components/home/EditorialHero.astro";
import FeatureCard from "../components/home/FeatureCard.astro";
import { getArticles } from "../lib/content";
import { getResources, resourceFiles, resourceUrl, KIND_LABEL } from "../lib/resources";
import { ancestry, getTopics, inTopic, topicUrl } from "../lib/topics";
import "../styles/editorial-home.css";
import { SITE } from "../site";

const [articles, topics, projects, resources] = await Promise.all([
  getArticles(),
  getTopics(),
  getCollection("projects"),
  getResources(),
]);
const recent = articles.slice(0, 6);
const topicIds = Object.fromEntries(recent.map((article) => [
  article.id,
  [...new Set(article.data.topics.flatMap((topic) => ancestry(topic.id, topics).map((parent) => parent.id)))],
]));
const recentTopics = new Set(Object.values(topicIds).flat());
// Topics in the recent list filter it in place; the rest stay plain links to their topic page.
const featuredTopics = SITE.featuredTopics
  .filter((id) => topics.has(id) && inTopic(id, articles, topics).length > 0)
  .map((id) => ({ id, label: topics.get(id)!.data.title, href: topicUrl(id), filter: recentTopics.has(id) }));

const website = {
  "@type": "WebSite",
  name: SITE.title,
  description: SITE.description,
  url: new URL("/", Astro.site).href,
  inLanguage: SITE.lang,
  author: { "@type": "Person", name: SITE.author.name, url: SITE.author.url },
};
---

<BaseLayout title={SITE.title} structuredData={[website]}>
  <div class="editorial-home" data-editorial-home>
    <EditorialHero topics={featuredTopics} />
    <div class="editorial-columns">
      <section aria-labelledby="recent-title">
        <div class="editorial-section-head">
          <h2 id="recent-title"><span>01</span>最近文章</h2>
          <span data-home-count aria-live="polite">{recent.length} 篇笔记</span>
        </div>
        <button class="topic-reset" type="button" data-home-reset hidden>清除主题</button>
        <ArticleList entries={recent} showCollection={false} topicIds={topicIds} />
        <p class="topic-empty" data-home-empty hidden>最近文章中没有匹配的主题，请清除筛选或浏览全部文章。</p>
        <a class="all-articles" href="/knowledge/">全部文章 →</a>
      </section>
      <aside aria-labelledby="selected-title">
        <div class="editorial-section-head"><h2 id="selected-title"><span>02</span>在做与分享</h2></div>
        {projects.map((project) => (
          <FeatureCard title={project.data.title} description={project.data.description}
            href={`/projects/${project.id}/`} label="PROJECT / 项目"
            tags={project.data.topics.map((topic) => topics.get(topic.id)?.data.title ?? topic.id)}
            site={project.data.artwork} />
        ))}
        {resources.slice(0, 2).map((resource) => (
          <FeatureCard title={resource.data.title} description={resource.data.description}
            href={resourceUrl(resource)} label={`RESOURCE / ${KIND_LABEL[resource.data.kind]}`}
            tags={[`${resourceFiles(resource).length} 个文件`, resource.data.license]} />
        ))}
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { initHomeTopics } from "../lib/home-topics";
  const home = document.querySelector<HTMLElement>("[data-editorial-home]");
  if (home) initHomeTopics(home);
</script>
