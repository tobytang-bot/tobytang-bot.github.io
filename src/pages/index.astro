---
import BaseLayout from "../layouts/BaseLayout.astro";
import ArticleList from "../components/ArticleList.astro";
import { getArticles } from "../lib/content";
import { SITE } from "../site";

const recent = (await getArticles()).slice(0, 10);
const website = {
  "@type": "WebSite",
  name: SITE.title,
  description: SITE.description,
  url: new URL("/", Astro.site).href,
  inLanguage: SITE.lang,
  author: { "@type": "Person", name: SITE.author.name, url: SITE.author.url },
};
---

<BaseLayout title={SITE.title} structuredData={[website]}>
  <div class="home">
    <h1>{SITE.title}</h1>
    <p class="lede">{SITE.description}</p>

    <section aria-labelledby="recent-title">
      <h2 id="recent-title">最近更新</h2>
      <ArticleList entries={recent} />
    </section>
  </div>
</BaseLayout>

<style>
  .home {
    max-width: var(--measure);
  }

  h1 {
    margin: 0 0 0.5rem;
    font-size: var(--text-3xl);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .lede {
    margin: 0 0 3rem;
    color: var(--ink-2);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  h2 {
    margin: 0 0 0.75rem;
    font-size: var(--text-sm);
    font-weight: 600;
    color: var(--ink-3);
  }
</style>
