---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Sidebar from "../components/Sidebar.astro";
import { SITE } from "../site";
import { LEGACY_THEME, SYSTEM_THEME, THEMES } from "../lib/themes";
// Preloading the Latin subset avoids a layout shift when the web font swaps in.
import plexLatin from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";

interface ArticleMeta {
  published: Date;
  modified?: Date;
  section: string;
  tags: string[];
}

interface Props {
  title: string;
  description?: string;
  /** Adds Open Graph article fields. */
  article?: ArticleMeta;
  /** JSON-LD objects for this page. */
  structuredData?: Record<string, unknown>[];
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  article,
  structuredData = [],
  noindex = false,
} = Astro.props;
const fullTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const feed = new URL("/feed.xml", Astro.site);
const hasAside = Astro.slots.has("aside");
// Passed to the head script: { id: [scheme, bg] }.
const themeTable = Object.fromEntries(THEMES.map((t) => [t.id, [t.scheme, t.bg]]));
// "<" is escaped so content can never close the <script> element early.
const jsonLd = (data: Record<string, unknown>) =>
  JSON.stringify({ "@context": "https://schema.org", ...data }).replace(/</g, "\\u003c");
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={plexLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href={feed} />
    <link rel="sitemap" href="/sitemap.xml" />

    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    {
      article && (
        <>
          <meta property="article:published_time" content={article.published.toISOString()} />
          {article.modified && (
            <meta property="article:modified_time" content={article.modified.toISOString()} />
          )}
          <meta property="article:author" content={SITE.author.name} />
          <meta property="article:section" content={article.section} />
          {article.tags.map((tag) => (
            <meta property="article:tag" content={tag} />
          ))}
        </>
      )
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {structuredData.map((data) => <script type="application/ld+json" set:html={jsonLd(data)} />)}
    <meta name="theme-color" content="#f7f8fa" />
    <script is:inline define:vars={{ themeTable, SYSTEM_THEME, LEGACY_THEME }}>
      // Runs before first paint: pick the stored theme, or follow the system.
      const root = document.documentElement;
      let stored = null;
      try {
        stored = localStorage.getItem("theme");
        if (stored && LEGACY_THEME[stored]) {
          stored = LEGACY_THEME[stored]; // migrate the old light/dark toggle value
          localStorage.setItem("theme", stored);
        }
      } catch {}
      const manual = Boolean(stored && themeTable[stored]);
      const theme = manual
        ? stored
        : SYSTEM_THEME[matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"];
      root.dataset.theme = theme;
      root.dataset.scheme = themeTable[theme][0];
      if (!manual) root.dataset.themeAuto = "";
      document.querySelector('meta[name="theme-color"]').setAttribute("content", themeTable[theme][1]);
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <Header />
    <div class="shell" data-aside={hasAside ? "" : undefined}>
      <Sidebar />
      <main id="content" class="main">
        <slot />
      </main>
      {
        hasAside && (
          <div class="aside">
            <slot name="aside" />
          </div>
        )
      }
    </div>
  </body>
</html>

<style>
  .shell {
    display: grid;
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    max-width: var(--shell-w);
    margin: 0 auto;
  }

  .shell[data-aside] {
    grid-template-columns: var(--sidebar-w) minmax(0, 1fr) var(--toc-w);
  }

  .main {
    min-width: 0;
    padding: 2.75rem 3rem 6rem;
  }

  .aside {
    padding: 2.75rem 1.5rem 0 0;
  }

  @media (max-width: 1199px) {
    .shell[data-aside] {
      grid-template-columns: var(--sidebar-w) minmax(0, 1fr);
    }
    .aside {
      display: none;
    }
  }

  @media (max-width: 860px) {
    .shell,
    .shell[data-aside] {
      grid-template-columns: minmax(0, 1fr);
    }
    .main {
      padding: 1.75rem 1rem 4rem;
    }
  }
</style>
