---
// Appearance menu: a header button opening a panel with the mode
// (follow system / light / dark), the palette, Liquid Glass intensity and
// Reduce Motion. There is one palette slider per scheme; only the one for the
// scheme in use is shown, and each scheme keeps its own choice.
// The palette control looks like a discrete slider but is a radio group, so
// screen readers announce theme names: arrows move and select, Home/End jump
// to the ends. Dragging across it previews each theme and saves on release;
// discrete changes crossfade (see theme-manager.ts).
// State and storage live in src/lib/theme-manager.ts.
import { GLASS_LEVELS, MODES, THEMES } from "../lib/themes";

const schemes = (["light", "dark"] as const).map((scheme) => ({
  scheme,
  themes: THEMES.filter((t) => t.scheme === scheme),
}));
---

<div class="theme-menu" data-theme-menu>
  <button
    type="button"
    class="trigger"
    aria-expanded="false"
    aria-controls="theme-panel"
    title="外观"
    data-theme-trigger
  >
    <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
      <circle cx="12" cy="12" r="8" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
      <path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"></path>
    </svg>
    <span class="visually-hidden">外观</span>
  </button>

  <div class="panel" id="theme-panel" role="group" aria-labelledby="theme-panel-title" hidden data-theme-panel>
    <p class="title" id="theme-panel-title">外观</p>

    <p class="label" id="theme-mode-label">模式</p>
    <div class="segmented" role="radiogroup" aria-labelledby="theme-mode-label" data-theme-modes>
      {
        MODES.map((m) => (
          <button type="button" role="radio" aria-checked="false" tabindex="-1" data-mode={m.id}>
            {m.label}
          </button>
        ))
      }
    </div>

    <p class="label" id="theme-palette-label">配色</p>
    {
      schemes.map(({ scheme, themes }) => (
        <div
          class="slider"
          role="radiogroup"
          aria-labelledby="theme-palette-label"
          data-theme-slider={scheme}
          hidden={scheme === "dark"}
          style={`--stops: ${themes.length}`}
        >
          <span class="track" aria-hidden="true" />
          {themes.map((t) => (
            <button
              type="button"
              class="stop"
              role="radio"
              aria-checked="false"
              tabindex="-1"
              data-palette={t.id}
              style={`--swatch: ${t.swatch}`}
            >
              <span class="dot" aria-hidden="true" />
              <span class="name">{t.label}</span>
            </button>
          ))}
        </div>
      ))
    }

    <p class="label glass-label" id="theme-glass-label">玻璃强度</p>
    <div class="segmented glass" role="radiogroup" aria-labelledby="theme-glass-label">
      {
        GLASS_LEVELS.map((g) => (
          <button type="button" role="radio" aria-checked="false" tabindex="-1" data-glass={g.id}>
            {g.label}
          </button>
        ))
      }
    </div>

    <div class="motion">
      <span id="theme-motion-label">减少动态效果</span>
      <button
        type="button"
        class="switch"
        role="switch"
        aria-checked="false"
        aria-labelledby="theme-motion-label"
        aria-describedby="theme-motion-hint"
        data-theme-motion
      >
        <span class="knob" aria-hidden="true"></span>
      </button>
    </div>
    <p class="hint" id="theme-motion-hint" data-theme-motion-hint hidden>系统已开启减少动态效果。</p>
  </div>
</div>

<script>
  import {
    previewPalette,
    setGlass,
    setMode,
    setPalette,
    setReduceMotion,
    subscribe,
  } from "../lib/theme-manager";
  import type { GlassLevel, Scheme, ThemeId, ThemeMode } from "../lib/themes";

  // Moves and selects with arrows / Home / End, like a native radio group.
  function roving(buttons: HTMLButtonElement[], select: (b: HTMLButtonElement) => void) {
    buttons.forEach((button, i) => {
      button.addEventListener("keydown", (e) => {
        const last = buttons.length - 1;
        const next =
          e.key === "ArrowRight" || e.key === "ArrowDown" ? (i === last ? 0 : i + 1)
          : e.key === "ArrowLeft" || e.key === "ArrowUp" ? (i === 0 ? last : i - 1)
          : e.key === "Home" ? 0
          : e.key === "End" ? last
          : -1;
        if (next < 0) return;
        e.preventDefault();
        select(buttons[next]);
        buttons[next].focus();
      });
    });
  }

  function check(buttons: HTMLButtonElement[], selected: HTMLButtonElement | undefined) {
    for (const b of buttons) {
      b.setAttribute("aria-checked", String(b === selected));
      b.tabIndex = b === selected ? 0 : -1;
    }
  }

  for (const menu of document.querySelectorAll<HTMLElement>("[data-theme-menu]")) {
    const trigger = menu.querySelector<HTMLButtonElement>("[data-theme-trigger]")!;
    const panel = menu.querySelector<HTMLElement>("[data-theme-panel]")!;
    const sliders = [...menu.querySelectorAll<HTMLElement>("[data-theme-slider]")];
    const motion = menu.querySelector<HTMLButtonElement>("[data-theme-motion]")!;
    const motionHint = menu.querySelector<HTMLElement>("[data-theme-motion-hint]")!;
    const modes = [...menu.querySelectorAll<HTMLButtonElement>("[data-mode]")];
    const stops = [...menu.querySelectorAll<HTMLButtonElement>("[data-palette]")];
    const glasses = [...menu.querySelectorAll<HTMLButtonElement>("[data-glass]")];

    // Open / close
    const setOpen = (open: boolean) => {
      panel.hidden = !open;
      trigger.setAttribute("aria-expanded", String(open));
      if (open) modes.find((b) => b.tabIndex === 0)?.focus();
    };
    trigger.addEventListener("click", () => setOpen(trigger.ariaExpanded !== "true"));
    menu.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || panel.hidden) return;
      setOpen(false);
      trigger.focus();
    });
    document.addEventListener("pointerdown", (e) => {
      if (!panel.hidden && !menu.contains(e.target as Node)) setOpen(false);
    });
    menu.addEventListener("focusout", (e) => {
      if (!panel.hidden && !menu.contains(e.relatedTarget as Node | null) && e.relatedTarget) setOpen(false);
    });

    // Mode
    for (const b of modes) b.addEventListener("click", () => setMode(b.dataset.mode as ThemeMode));
    roving(modes, (b) => setMode(b.dataset.mode as ThemeMode));

    // Palette: click / keys save directly; dragging previews, release saves.
    const paletteOf = (b: HTMLButtonElement) => b.dataset.palette as ThemeId;
    for (const slider of sliders) {
      const own = [...slider.querySelectorAll<HTMLButtonElement>("[data-palette]")];
      for (const b of own) b.addEventListener("click", () => setPalette(paletteOf(b)));
      roving(own, (b) => setPalette(paletteOf(b)));

      const nearest = (x: number) => {
        let best = own[0];
        let bestDistance = Infinity;
        for (const b of own) {
          const r = b.getBoundingClientRect();
          const distance = Math.abs(r.left + r.width / 2 - x);
          if (distance < bestDistance) [best, bestDistance] = [b, distance];
        }
        return best;
      };
      // A plain click isn't previewed, so saving it crossfades; once the
      // pointer moves, previews are instant to keep up with it.
      let dragging = false;
      let startX = 0;
      let moved = false;
      slider.addEventListener("pointerdown", (e) => {
        if (e.button !== 0) return;
        dragging = true;
        moved = false;
        startX = e.clientX;
        slider.setPointerCapture(e.pointerId);
      });
      slider.addEventListener("pointermove", (e) => {
        if (!dragging) return;
        moved ||= Math.abs(e.clientX - startX) > 4;
        if (moved) previewPalette(paletteOf(nearest(e.clientX)));
      });
      slider.addEventListener("pointerup", (e) => {
        if (!dragging) return;
        dragging = false;
        const b = nearest(e.clientX);
        setPalette(paletteOf(b));
        b.focus();
      });
      slider.addEventListener("pointercancel", () => {
        dragging = false;
        previewPalette(null);
      });
    }

    // Glass intensity
    for (const b of glasses) b.addEventListener("click", () => setGlass(b.dataset.glass as GlassLevel));
    roving(glasses, (b) => setGlass(b.dataset.glass as GlassLevel));

    // Reduce Motion
    motion.addEventListener("click", () => setReduceMotion(motion.ariaChecked !== "true"));

    subscribe((state) => {
      check(modes, modes.find((b) => b.dataset.mode === state.mode));
      for (const slider of sliders) {
        const scheme = slider.dataset.themeSlider as Scheme;
        const own = stops.filter((b) => slider.contains(b));
        check(own, own.find((b) => b.dataset.palette === state.palettes[scheme]));
        slider.hidden = scheme !== state.scheme;
      }
      check(glasses, glasses.find((b) => b.dataset.glass === state.glass));
      // The dot under the pointer while dragging.
      for (const b of stops) b.toggleAttribute("data-preview", b.dataset.palette === state.preview);
      // A system setting can't be overridden here: show it as on and locked.
      motion.setAttribute("aria-checked", String(state.reduceMotion || state.systemReducedMotion));
      motion.disabled = state.systemReducedMotion;
      motionHint.hidden = !state.systemReducedMotion;
    });
  }
</script>

<style>
  .theme-menu {
    position: relative;
  }

  .trigger {
    display: inline-grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }

  .trigger:hover,
  .trigger[aria-expanded="true"] {
    color: var(--ink);
    background: var(--surface-2);
  }

  .panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0;
    z-index: 50;
    width: min(19rem, calc(100vw - 2rem));
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 8px 30px rgb(0 0 0 / 0.12);
  }

  .panel[hidden] {
    display: none;
  }

  .title {
    margin: 0 0 0.75rem;
    font-weight: 600;
  }

  .label {
    margin: 0 0 0.4rem;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  /* Mode and glass intensity: segmented controls */
  .segmented {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    margin-bottom: 1rem;
    padding: 2px;
    border-radius: var(--radius);
    background: var(--surface-2);
  }

  .segmented button {
    min-height: 2rem;
    padding: 0 0.25rem;
    border: 0;
    border-radius: 6px;
    background: none;
    color: var(--ink-2);
    font: inherit;
    font-size: var(--text-sm);
    cursor: pointer;
  }

  .segmented button[aria-checked="true"] {
    background: var(--surface);
    color: var(--ink);
    font-weight: 550;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.12);
  }

  /* Color: discrete slider. Each stop is a full-width column so the touch
     target stays large; the dot is drawn inside it. */
  .slider {
    position: relative;
    display: grid;
    grid-template-columns: repeat(var(--stops), 1fr);
    touch-action: pan-y;
    user-select: none;
  }

  .track {
    position: absolute;
    top: 1.125rem;
    /* From the first dot's center to the last one's. */
    left: calc(50% / var(--stops));
    right: calc(50% / var(--stops));
    height: 2px;
    border-radius: 1px;
    background: var(--border);
  }

  .stop {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.35rem;
    padding: 0.5rem 0 0.25rem;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--ink-3);
    font: inherit;
    font-size: var(--text-xs);
    cursor: pointer;
  }

  .dot {
    position: relative;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 50%;
    background: var(--swatch);
    /* Keeps swatches visible on both light and dark panels. */
    box-shadow: inset 0 0 0 1px rgb(128 128 128 / 0.4);
    transition: transform 120ms ease;
  }

  .stop:hover .dot,
  .stop[data-preview] .dot {
    transform: scale(1.15);
  }

  /* Selected: larger dot with the Liquid Glass rim gradient ring. */
  .stop[aria-checked="true"] {
    color: var(--ink);
    font-weight: 550;
  }

  .stop[aria-checked="true"] .dot {
    transform: scale(1.2);
  }

  .stop[aria-checked="true"] .dot::after {
    content: "";
    position: absolute;
    inset: -4px;
    padding: 2px;
    border-radius: 50%;
    background: var(--rim-gradient);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
  }

  .slider[hidden] {
    display: none;
  }

  .name {
    white-space: nowrap;
  }

  .hint {
    margin: 0.6rem 0 0;
    color: var(--ink-3);
    font-size: var(--text-xs);
    line-height: 1.5;
  }

  .glass-label {
    margin-top: 1rem;
  }

  .segmented.glass {
    margin-bottom: 0;
  }

  .hint[hidden] {
    display: none;
  }

  /* Reduce Motion switch */
  .motion {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 1rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
  }

  .switch {
    position: relative;
    flex: none;
    width: 2.25rem;
    height: 1.25rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: var(--border);
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .switch[aria-checked="true"] {
    background: var(--accent);
  }

  .switch:disabled {
    opacity: 0.55;
    cursor: not-allowed;
  }

  .knob {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: var(--ink-3);
    transition: transform 150ms ease;
  }

  .switch[aria-checked="true"] .knob {
    background: var(--on-accent);
    transform: translateX(1rem);
  }
</style>
