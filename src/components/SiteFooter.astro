---
import { SITE } from "../site";
---

<footer class="site-footer">
  <div class="identity"><a href="/">{SITE.title}</a><p>工程有迹，知识可循。</p></div>
  <nav aria-label="更多入口">
    <a href="/topics/">主题</a><a href="/archive/">归档</a>
    <a href={SITE.repository}>GitHub</a><a href="/feed.xml">RSS</a>
  </nav>
</footer>

<style>
  .site-footer { max-width:var(--shell-w); margin:0 auto; padding:1.5rem 2.5rem 2rem; border-top:1px solid var(--border); display:flex; justify-content:space-between; gap:1.5rem; font-size:var(--text-xs); color:var(--ink-3); }
  .identity { min-width:0; }
  .identity a { font-weight:600; color:var(--ink); overflow-wrap:anywhere; }
  p { margin:0.35rem 0 0; }
  nav { display:flex; align-items:start; flex-wrap:wrap; gap:1.25rem; }
  a { text-decoration:none; }
  a:hover { color:var(--accent); }
  @media(max-width:680px) { .site-footer { padding:1.5rem 1rem; flex-direction:column; gap:1rem; } }
</style>
