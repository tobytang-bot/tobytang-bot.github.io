---
import type { GraphTopic } from "../../lib/motion/graph-data";
interface Props { nodes: GraphTopic[] }
const { nodes } = Astro.props;
---

<nav class="hero-graph" data-hero-graph aria-label="探索知识领域">
  <canvas aria-hidden="true"></canvas>
  <div class="graph-heading"><span>Engineering Worklog</span><small>知识之间的连接</small></div>
  <ul class="graph-topics">
    {nodes.map((node) => (
      <li><a href={node.href} data-graph-node><span>{node.label}</span><small>{node.count} 条内容</small></a></li>
    ))}
  </ul>
</nav>

<script>
  import { mountGraph } from "../../lib/motion/graph-controller";
  const graph = document.querySelector<HTMLElement>("[data-hero-graph]");
  if (graph) {
    let dispose = mountGraph(graph);
    window.addEventListener("pagehide", () => dispose());
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) dispose = mountGraph(graph);
    });
  }
</script>
