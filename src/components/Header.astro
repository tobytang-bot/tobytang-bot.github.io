---
import Search from "./Search.astro";
import ThemeToggle from "./ThemeToggle.astro";
---

<header class="site-header">
  <div class="inner">
    <button
      class="nav-toggle"
      type="button"
      aria-controls="site-nav"
      aria-expanded="false"
      data-nav-toggle
    >
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"></path>
      </svg>
      <span class="visually-hidden">打开导航</span>
    </button>

    <a class="wordmark" href="/">
      <span class="wordmark-name">Toby</span>
      <span class="wordmark-kind">Worklog</span>
    </a>

    <div class="actions">
      <Search />
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    border-bottom: 1px solid var(--border);
    background: var(--glass);
    backdrop-filter: blur(14px) saturate(1.5);
    -webkit-backdrop-filter: blur(14px) saturate(1.5);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    height: 100%;
    max-width: var(--shell-w);
    margin: 0 auto;
    padding: 0 1.25rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    text-decoration: none;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .wordmark-name {
    font-weight: 650;
  }

  .wordmark-kind {
    color: var(--ink-3);
    font-weight: 450;
  }

  .actions {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-toggle {
    display: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: -0.5rem;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--ink-2);
    cursor: pointer;
  }

  @media (max-width: 860px) {
    .nav-toggle {
      display: inline-grid;
    }
    .inner {
      padding: 0 1rem;
    }
  }
</style>
