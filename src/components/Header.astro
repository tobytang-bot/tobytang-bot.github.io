---
import Search from "./Search.astro";
import ThemePicker from "./ThemePicker.astro";
import { NAV, SITE } from "../site";
const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="inner">
    <a class="wordmark" href="/" aria-label={SITE.title}>
      <img class="wordmark-logo" src="/logo.png" alt="" width="32" height="32" />
      <span class="wordmark-name">{SITE.title}</span>
    </a>

    <nav aria-label="主导航">
      {NAV.map((item) => (
        <a href={item.url} aria-current={path === item.url ? "page" : item.sections.some((section) => path.startsWith(section)) ? "true" : undefined}>{item.title}</a>
      ))}
    </nav>

    <div class="actions">
      <Search />
      <ThemePicker />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    height: var(--header-h);
    border-bottom: 1px solid var(--border);
    background: var(--glass);
    backdrop-filter: blur(14px) saturate(1.5);
  }

  .inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 100%;
    max-width: var(--shell-w);
    margin: 0 auto;
    padding: 0 2.5rem;
  }

  .wordmark {
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    text-decoration: none;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
  }

  .wordmark-logo {
    flex: none;
    width: 2rem;
    height: 2rem;
    margin-right: 0.15rem;
    border-radius: 50%;
  }

  .wordmark-name {
    font-weight: 650;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .actions {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  nav { display:flex; gap:1.8rem; margin-left:auto; flex:none; }
  nav a { text-decoration:none; color:var(--ink-2); font-size:var(--text-sm); padding:0.5rem 0; }
  nav a:hover, nav a[aria-current] { color:var(--accent); }
  nav a[aria-current] { text-decoration:underline; text-underline-offset:0.5rem; }
  .actions :global(.search-trigger .trigger-label) { min-width:0; }
  .actions :global(.search-trigger kbd) { display:none; }

  @media (max-width: 860px) { .inner { padding:0 1rem; gap:1.25rem; } nav { gap:1.25rem; } }
  @media (max-width: 680px) {
    .inner { display:grid; grid-template-columns:1fr auto; grid-template-rows:2.4rem 2.8rem; gap:0.15rem 0.75rem; align-content:center; }
    .wordmark { grid-column:1 / -1; font-size:1rem; }
    nav { margin:0; gap:1.25rem; }
    .actions { gap:0.4rem; }
    .actions :global(.search-trigger) { padding:0 0.5rem; }
  }
</style>
